# Copy to .env. Never commit your real credentials.
NCBI_EMAIL=
NCBI_API_KEY=
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-before-sharing
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=lancard/korean-yanolja-eeve
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
# A separate v2 index preserves the original chroma_db_hf directory.
CHROMA_PATH=chroma_db_v2
CHROMA_COLLECTION=biolab_methods_v2
