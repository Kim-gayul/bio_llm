# Copy to .env. Never commit your real credentials.
NCBI_EMAIL=
NCBI_API_KEY=
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-before-sharing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Fast query rewrite; answer quality remains on Astra with low reasoning effort.
OPENAI_QUERY_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_QUERY_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_QUERY_MAX_OUTPUT_TOKENS=512
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
# A separate v2 index preserves the original chroma_db_hf directory.
CHROMA_PATH=chroma_db_v2
CHROMA_COLLECTION=biolab_methods_v2
